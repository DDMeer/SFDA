# 数据集
*.parquet
data/

# 虚拟环境
.venv/

# Python 缓存
__pycache__/
*.pyc

# macOS
.DS_Store

# 特征缓存（可由 scripts/cache_features.py 重建）
cache/

# 源模型权重体积大（ResNet-50 约 100MB），不入库
checkpoints/source/

# 训练日志（可由重跑复现；值得留存的是 baseline JSON / 配置 / seed / checkpoint metadata）
logs/

# Stage 1 权重约 67MB 不入库；同目录的 .json 指标保留跟踪
checkpoints/stage1/*.pth
